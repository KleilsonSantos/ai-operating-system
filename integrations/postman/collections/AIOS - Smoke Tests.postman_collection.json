{
  "info": {
    "name": "AIOS - Smoke Tests",
    "description": "SMOKE suite for the HTTP surfaces implemented by apps/console/src/server.ts and apps/mcp/src/http.ts.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "consoleBaseUrl", "value": "http://127.0.0.1:8787" },
    { "key": "mcpBaseUrl", "value": "http://127.0.0.1:8791" }
  ],
  "item": [
    {
      "name": "SMOKE-001 Console health",
      "request": { "method": "GET", "url": "{{consoleBaseUrl}}/api/health" },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('service is console API', () => pm.expect(pm.response.json().service).to.eql('aios-console-api'));",
              "pm.test('healthy', () => pm.expect(pm.response.json().ok).to.eql(true));"
            ]
          }
        }
      ]
    },
    {
      "name": "SMOKE-002 Console status",
      "request": { "method": "GET", "url": "{{consoleBaseUrl}}/api/status" },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('JSON object returned', () => pm.expect(pm.response.json()).to.be.an('object')); "
            ]
          }
        }
      ]
    },
    {
      "name": "SMOKE-003 Console metrics",
      "request": { "method": "GET", "url": "{{consoleBaseUrl}}/metrics" },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Prometheus content type', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('text/plain')); "
            ]
          }
        }
      ]
    },
    {
      "name": "SMOKE-004 MCP health (HTTP opt-in)",
      "request": { "method": "GET", "url": "{{mcpBaseUrl}}/health" },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('MCP HTTP transport is reported', () => pm.expect(pm.response.json().transport).to.eql('streamable-http')); "
            ]
          }
        }
      ]
    }
  ]
}
