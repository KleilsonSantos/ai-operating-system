{
  "name": "@aios-platform/agent-registry",
  "version": "0.48.5",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "description": "Agent Registry for AIOS – discovery, validation, and resolution of agent metadata",
  "files": [
    "dist/**/*",
    "schema/**/*",
    "data/**/*",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "node -e \"process.exit(0)\"",
    "test": "vitest run"
  },
  "keywords": [
    "aios",
    "agent",
    "registry",
    "metadata"
  ],
  "author": "Kleilson Santos <kdsdesign1@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KleilsonSantos/ai-operating-system.git",
    "directory": "packages/agent-registry"
  },
  "homepage": "https://github.com/KleilsonSantos/ai-operating-system/tree/main/packages/agent-registry",
  "bugs": {
    "url": "https://github.com/KleilsonSantos/ai-operating-system/issues"
  },
  "engines": {
    "node": ">=22.13"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "js-yaml": "^5.4.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.4.0",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11"
  }
}
