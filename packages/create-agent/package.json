{
  "name": "@aios-platform/create-agent",
  "version": "0.48.6",
  "type": "module",
  "description": "Scaffold an AIOS agent package (npm create @aios-platform/agent)",
  "bin": {
    "create-agent": "./dist/cli.js"
  },
  "main": "./dist/scaffold.js",
  "types": "./dist/scaffold.d.ts",
  "exports": {
    ".": {
      "types": "./dist/scaffold.d.ts",
      "import": "./dist/scaffold.js"
    }
  },
  "files": [
    "dist/**/*",
    "template/**/*",
    "README.md"
  ],
  "scripts": {
    "dev": "pnpm run build && node ./dist/cli.js",
    "build": "tsc -p tsconfig.json",
    "prepack": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "node -e \"process.exit(0)\"",
    "test": "vitest run"
  },
  "keywords": [
    "aios",
    "agent",
    "scaffold",
    "create"
  ],
  "author": "Kleilson Santos <kdsdesign1@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KleilsonSantos/ai-operating-system.git",
    "directory": "packages/create-agent"
  },
  "homepage": "https://github.com/KleilsonSantos/ai-operating-system/tree/main/packages/create-agent",
  "bugs": {
    "url": "https://github.com/KleilsonSantos/ai-operating-system/issues"
  },
  "engines": {
    "node": ">=22.13"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@aios-platform/agent-registry": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11"
  }
}
