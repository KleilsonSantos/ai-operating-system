{
  "name": "@aios/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "aios": "./src/index.ts"
  },
  "scripts": {
    "dev": "tsx ./src/index.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "node -e \"process.exit(0)\"",
    "test": "vitest run"
  },
  "dependencies": {
    "@aios-platform/agent-registry": "workspace:*",
    "@aios/documentation": "workspace:*",
    "@aios/governance": "workspace:*",
    "@aios/operational-state": "workspace:*",
    "@aios/visibility": "workspace:*",
    "@aios/pipeline": "workspace:*",
    "@aios/policy": "workspace:*",
    "@aios/prompt": "workspace:*",
    "@aios/provider": "workspace:*",
    "@aios/shared": "workspace:*",
    "@aios/status": "workspace:*",
    "@aios/workspace": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11"
  }
}
