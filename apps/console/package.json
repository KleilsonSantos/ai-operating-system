{
  "name": "@aios/console",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "UI de governança — Health + Attention (#71).",
  "scripts": {
    "dev": "concurrently -k -n api,ui -c teal,cyan \"pnpm api\" \"pnpm ui\"",
    "api": "tsx ./src/server.ts",
    "ui": "vite",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "lint": "node -e \"process.exit(0)\"",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "@aios/documentation": "workspace:*",
    "@aios/governance": "workspace:*",
    "@aios/memory": "workspace:*",
    "@aios/operational-state": "workspace:*",
    "@aios/policy": "workspace:*",
    "@aios/prompt": "workspace:*",
    "@aios/provider": "workspace:*",
    "@aios/shared": "workspace:*",
    "@aios/status": "workspace:*",
    "@aios/workspace": "workspace:*",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.12",
    "typescript": "^5.9.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
