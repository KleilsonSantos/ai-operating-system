{
  "name": "ai-operating-system",
  "private": true,
  "type": "module",
  "version": "0.49.13",
  "description": "AI Operating System — plataforma de governança para IA aplicada ao desenvolvimento de software",
  "license": "MIT",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "pnpm --filter @aios/cli dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:md": "markdownlint-cli2",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node scripts/run-test-coverage.mjs",
    "test:coverage": "node scripts/run-test-coverage.mjs --coverage",
    "evals": "pnpm --filter @aios/evals evals",
    "audit": "audit-ci --moderate",
    "prepare": "git config core.hooksPath .githooks || true",
    "sync:cursor-rules": "node scripts/sync-cursor-rules-from-policies.mjs",
    "community:ingest": "node scripts/community-agents-ingest.mjs",
    "create-agent:pack-smoke": "bash scripts/smoke-create-agent-pack.sh",
    "create-agent:publish": "bash scripts/npm-publish-create-agent.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitest/coverage-v8": "^4.1.11",
    "audit-ci": "^7.1.0",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "lint-staged": "^17.3.0",
    "markdownlint-cli2": "^0.23.2",
    "prettier": "^3.9.8",
    "turbo": "^2.10.12",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.70.0"
  }
}
